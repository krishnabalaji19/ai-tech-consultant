# Copy this file to .env and fill in your own keys.
# Never put real keys in this file.

# Which LLM to use: gemini (default, free) or claude
LLM_PROVIDER=gemini

# Gemini (free tier). Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Checked 2026-10-17 against this project's API key and Google's free-tier list.
# gemini-2.0-flash is shut down. gemini-3.5-flash-lite is listed and free of charge.
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude. Required only if you switch LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Task 1 Knowledge Brain
TASK1_HOST=127.0.0.1
TASK1_PORT=8001
KNOWLEDGE_API_URL=http://127.0.0.1:8001
QUERY_TOP_K=5
QUERY_MAX_DISTANCE=0.85
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
ROBOTS_URL=https://support.brilliantdirectories.com/robots.txt
CRAWL_USER_AGENT=AITechConsultant/0.1 (educational capstone; polite crawler)
INGEST_MAX_PAGES=30
CRAWL_PATH_CONTAINS=/solutions/articles/
CRAWL_PRIORITY_SUBSTRINGS=refund
CRAWL_MAX_CONCURRENCY=2
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_COLLECTION=help_chunks
CRAWL_DELAY_SECONDS=1.5
CRAWL_MAX_RETRIES=4
CRAWL_RETRY_BASE_SECONDS=1.0
CRAWL_TIMEOUT_SECONDS=30

# Task 2 Inbox Agent
TASK2_HOST=127.0.0.1
TASK2_PORT=8002
AUTO_SEND_THRESHOLD=20

# Task 3 Meeting to Scope
TASK3_HOST=127.0.0.1
TASK3_PORT=8003
